# Configuração compartilhada da SDIC Libraries (VERSIONADA)
# Contém apenas configuração pública. NÃO coloque segredos aqui.
# Segredos (ex.: EMPLOYMENT_API_KEY) devem ir em .env.local (ignorado pelo git).

# Endpoint público da API via DNS próprio (não expõe a conta de serviço / projeto GCP).
EMPLOYMENT_API_BASE_URL=https://sdicapi.dados.ninja

# Opcionais
API_TIMEOUT=30
LOG_LEVEL=INFO
