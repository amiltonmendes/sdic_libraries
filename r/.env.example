# Modelo de configuração da sdic.libraries (0.6.0). Copie para `.env.local` (não versionado)
# na pasta do seu projeto, ou defina as variáveis no ambiente (ex.: ~/.Renviron).
# Ordem de leitura: argumento > variável de ambiente > .env.local > .env > ~/.env > /etc/sdic/.env.
# `sdic_config()` mostra o que está valendo e de onde veio.
#
# IMPORTANTE: a chave vai SOMENTE em .env.local ou em variável de ambiente, nunca em arquivo versionado.

# SDIC_API_KEY=            # chave individual da sdic_api
# SDIC_API_URL=https://sdicapi.dados.ninja
# SDIC_DADOS_URL=https://storage.googleapis.com/fast-sdic-dados
# SDIC_PAGES_URL=https://amiltonmendes.github.io/sdic_libraries
# SDIC_AMBIENTE=producao   # ou homologacao
# SDIC_TIMEOUT=30          # segundos
# SDIC_CACHE_TTL=0         # segundos; 0 = sem cache local
# SDIC_CACHE_DIR=
