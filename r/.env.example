# Modelo de configuração da SDIC Libraries.
# A configuração pública já vem no .env versionado na raiz do projeto.
# Use este modelo apenas se precisar sobrescrever localmente.
#
# IMPORTANTE: segredos (ex.: EMPLOYMENT_API_KEY) vão SOMENTE em .env.local (ignorado),
# nunca em arquivos versionados.

# Endpoint público da API (DNS próprio)
EMPLOYMENT_API_BASE_URL=https://sdicapi.dados.ninja

# EMPLOYMENT_API_KEY=  # -> defina em .env.local, não aqui
# API_TIMEOUT=30
# LOG_LEVEL=INFO
# SDIC_VERSION=0.3.1
