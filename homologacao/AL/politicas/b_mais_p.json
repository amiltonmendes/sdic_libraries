      {
        "tone": "pos",
        "text": "Ganho mediano de 32,2% de produtividade nas empresas industriais concluintes (SENAI)."
      },
      {
        "tone": "neutral",
        "text": "R$ 682,2 mi mobilizados em inovação e financiamento (EMBRAPII + BNDES)."
      }
