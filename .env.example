# ==================================================================
# SDIC Libraries - Environment Variable Configuration
# ==================================================================
# 🎯 AUTOMATIC LOADING: This file is detected and loaded automatically!
#    Just rename this to '.env' and the library will use it seamlessly.
#
# 🔍 SEARCH PRIORITY:
#    1. System environment variables (highest priority)
#    2. ./.env file (current directory)
#    3. ~/.env file (user home directory)
#    4. Library defaults (fallback)
#
# ⚡ NO SETUP REQUIRED: Libraries automatically load configuration
#    without any user intervention - it just works!
# ==================================================================

# Employment API Configuration
# A configuração pública já vem no .env versionado na raiz. Sobrescreva aqui se precisar.
# Endpoint público da API (DNS próprio — não expõe a conta de serviço / projeto GCP)
EMPLOYMENT_API_BASE_URL=https://sdicapi.dados.ninja
# Segredos (chave da API) vão SOMENTE em .env.local (ignorado pelo git), nunca aqui:
# EMPLOYMENT_API_KEY=  # -> .env.local

# Portal/Relatório de Emprego (artefatos publicados no GitHub Pages — dados.emprego.portal)
# URL pública base onde o cgid_cargas publica os JSONs de emprego por estado.
PORTAL_EMPREGO_BASE_URL=https://amiltonmendes.github.io/sdic_libraries
# Ambiente default de leitura: producao (default) ou homologacao
PORTAL_EMPREGO_AMBIENTE=producao

# Request Configuration
# Timeout in seconds for HTTP requests
API_TIMEOUT=30

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Library Version  
# Used in User-Agent headers for API identification
SDIC_VERSION=0.4.0

# Database Configuration (For Future Extensions)
# DATABASE_URL=postgresql://user:pass@localhost/dbname
# DATABASE_TIMEOUT=60

# Cache Configuration (For Future Extensions)  
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=3600

# ==================================================================
# USAGE EXAMPLES:
# ==================================================================
# Python:
#   from sdic_libraries.data_access.employment import EmploymentAPI  
#   api = EmploymentAPI()  # Configuration loaded automatically!
#
# R:
#   library(sdic)
#   api <- EmploymentAPI$new()  # Environment loaded seamlessly!
# ==================================================================