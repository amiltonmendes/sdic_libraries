# sdic_libraries: configuração opcional. Copie para `.env` (valores não secretos) ou `.env.local` (a chave).
# Precedência: argumento da função > variável de ambiente > .env.local > .env > ~/.env > /etc/sdic/.env > padrão.
# A biblioteca só lê estes nomes e não altera o ambiente do processo. sdic_config() mostra o que está valendo.

# Chave individual da API. SOMENTE em .env.local (fora do git) ou em variável de ambiente:
# SDIC_API_KEY=

# producao (padrão) ou homologacao: vale para as seções publicadas e para as políticas
# SDIC_AMBIENTE=homologacao

# Endereços (os padrões estão em contrato/catalogo.json; defina só para apontar para outro lugar)
# SDIC_API_URL=https://sdicapi.dados.ninja
# SDIC_DADOS_URL=https://storage.googleapis.com/fast-sdic-dados
# SDIC_PAGES_URL=https://amiltonmendes.github.io/sdic_libraries

# SDIC_TIMEOUT=30        # segundos por requisição
# SDIC_CACHE_TTL=3600    # segundos de validade do cache em disco (0 ou ausente = desligado)
# SDIC_CACHE_DIR=        # pasta do cache (padrão: ~/.cache/sdic_libraries)
